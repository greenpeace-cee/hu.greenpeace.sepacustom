<?xml version="1.0"?>
<extension key="hu.greenpeace.sepacustom" type="module">
  <file>sepacustom</file>
  <name>GP Hungary SEPA Customisations</name>
  <description>Customised mandate references, transaction messages, etc.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Greenpeace CEE</author>
    <email>pfigel@greenpeace.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/greenpeace-cee/hu.greenpeace.sepacustom</url>
    <url desc="Documentation">https://github.com/greenpeace-cee/hu.greenpeace.sepacustom</url>
    <url desc="Support">https://github.com/greenpeace-cee/hu.greenpeace.sepacustom/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-20</releaseDate>
  <version>1.4.0</version>
  <develStage>stable</develStage>
  <compatibility>
    <ver>5.69</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Sepacustom</namespace>
    <format>24.09.1</format>
  </civix>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <mixins>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>afform-entity-php@1.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\Sepacustom\AutomaticUpgrader</upgrader>
</extension>
